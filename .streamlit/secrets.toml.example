# Copy this file to `secrets.toml` (same folder) and fill in real values.
# `secrets.toml` is git-ignored — credentials never enter the repository.
# On Streamlit Community Cloud / Hugging Face Spaces, paste this content
# into the deployment's "Secrets" field instead of uploading a file.

[smtp]
smtp_server = "smtp.gmail.com"
smtp_port = 587
sender_email = "your-address@example.com"
sender_password = "your-app-specific-password"
customer_email = "customer-warnings@example.com"
inspection_team_email = "inspection-team@example.com"
